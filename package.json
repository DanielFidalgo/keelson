{
  "name": "keelson",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "e2e"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "deps:check": "depcruise packages $(test -d apps && echo apps)",
    "test": "vitest run",
    "seed": "tsx scripts/seed-public-monitors.ts",
    "api:types": "openapi-typescript apps/api/openapi.yaml -o apps/dashboard/src/api/schema.d.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
